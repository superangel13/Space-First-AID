{
  "name": "space-first-aid-escritorio",
  "version": "1.0.0",
  "description": "Space First AID · programa de escritorio (React + Electron) con el motor en Python y SQLite",
  "author": "Equipo Space First AID",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "recursos": "node herramientas/copiar_recursos.mjs",
    "dev": "npm run recursos && vite",
    "build": "npm run recursos && vite build",
    "inicio": "npm run build && electron .",
    "electron": "electron .",
    "empaquetar": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "org.spacefirstaid.escritorio",
    "productName": "Space First AID",
    "directories": { "output": "salida" },
    "files": ["electron/**", "package.json"],
    "extraResources": [
      { "from": "dist", "to": "pantalla" },
      { "from": "motor", "to": "motor" }
    ],
    "mac": {
      "target": ["zip"],
      "icon": "../app/media/icono.png",
      "category": "public.app-category.medical",
      "extendInfo": { "NSCameraUsageDescription": "Space First AID usa la cámara para las pruebas de coordinación con la mano." }
    },
    "win": { "target": ["nsis", "portable"], "icon": "../app/media/icono.png" },
    "linux": { "target": ["AppImage"], "category": "Science" }
  }
}
